/*
 * ESP32-CAM Smart Traffic Control System - Traffic Controller
 * Target: Arduino UNO
 * Description: Non-blocking state machine for traffic lights with emergency priority.
 */

// Pin Definitions for Lane 1 (Ambulance Incoming Direction)
const int L1_RED = 2;
const int L1_YELLOW = 3;
const int L1_GREEN = 4;

// Pin Definitions for Lane 2 (Conflicting Cross Traffic)
const int L2_RED = 5;
const int L2_YELLOW = 6;
const int L2_GREEN = 7;

// Traffic States
enum TrafficState {
  L1_GREEN_STATE,
  L1_YELLOW_STATE,
  ALL_RED_1_STATE, // Red buffer before L2 turns Green
  L2_GREEN_STATE,
  L2_YELLOW_STATE,
  ALL_RED_2_STATE  // Red buffer before L1 turns Green
};

TrafficState currentState = L1_GREEN_STATE;
unsigned long previousMillis = 0;
bool emergencyPriority = false;

// Timing intervals (in milliseconds)
const long greenInterval = 10000; // Normal green light duration: 10 seconds
const long yellowInterval = 3000; // Safe clearance interval: 3 seconds (DO NOT SKIP)
const long redInterval = 2000;    // All-red safety interval: 2 seconds (DO NOT SKIP)

void setup() {
  Serial.begin(9600); // Communication with PC/Raspberry Pi (Python script)
  
  pinMode(L1_RED, OUTPUT); pinMode(L1_YELLOW, OUTPUT); pinMode(L1_GREEN, OUTPUT);
  pinMode(L2_RED, OUTPUT); pinMode(L2_YELLOW, OUTPUT); pinMode(L2_GREEN, OUTPUT);
  
  // Initialize default state: L1 Green, L2 Red
  setLights(LOW, LOW, HIGH, HIGH, LOW, LOW); 
}

void loop() {
  unsigned long currentMillis = millis();

  // 1. Read commands from the Central Vision Processor (Python)
  if (Serial.available() > 0) {
    char command = Serial.read();
    if (command == 'A') {
      emergencyPriority = true; // Ambulance detected in Lane 1
    } else if (command == 'N') {
      emergencyPriority = false; // Normal operation
    }
  }

  // 2. Handle Emergency Priority Interrupt
  if (emergencyPriority) {
    // If L1 is already green, freeze the timer so it stays green
    if (currentState == L1_GREEN_STATE) {
      previousMillis = currentMillis; 
    }
    // If L2 is green, safely abort L2 by switching to yellow immediately
    else if (currentState == L2_GREEN_STATE) {
      currentState = L2_YELLOW_STATE;
      previousMillis = currentMillis;
      setLights(HIGH, LOW, LOW, LOW, HIGH, LOW); // L1 Red, L2 Yellow
    }
    // Note: If state is currently Yellow or All-Red, we let it finish its 
    // safety timing naturally. It will cycle back to L1 Green safely.
  }

  // 3. Normal State Machine Execution
  switch (currentState) {
    
    case L1_GREEN_STATE:
      if (!emergencyPriority && (currentMillis - previousMillis >= greenInterval)) {
        currentState = L1_YELLOW_STATE;
        previousMillis = currentMillis;
        setLights(LOW, HIGH, LOW, HIGH, LOW, LOW); // L1 Yellow, L2 Red
      }
      break;

    case L1_YELLOW_STATE:
      if (currentMillis - previousMillis >= yellowInterval) {
        currentState = ALL_RED_1_STATE;
        previousMillis = currentMillis;
        setLights(HIGH, LOW, LOW, HIGH, LOW, LOW); // L1 Red, L2 Red
      }
      break;

    case ALL_RED_1_STATE:
      if (currentMillis - previousMillis >= redInterval) {
        currentState = L2_GREEN_STATE;
        previousMillis = currentMillis;
        setLights(HIGH, LOW, LOW, LOW, LOW, HIGH); // L1 Red, L2 Green
      }
      break;

    case L2_GREEN_STATE:
      if (currentMillis - previousMillis >= greenInterval) {
        currentState = L2_YELLOW_STATE;
        previousMillis = currentMillis;
        setLights(HIGH, LOW, LOW, LOW, HIGH, LOW); // L1 Red, L2 Yellow
      }
      break;

    case L2_YELLOW_STATE:
      if (currentMillis - previousMillis >= yellowInterval) {
        currentState = ALL_RED_2_STATE;
        previousMillis = currentMillis;
        setLights(HIGH, LOW, LOW, HIGH, LOW, LOW); // L1 Red, L2 Red
      }
      break;

    case ALL_RED_2_STATE:
      if (currentMillis - previousMillis >= redInterval) {
        currentState = L1_GREEN_STATE;
        previousMillis = currentMillis;
        setLights(LOW, LOW, HIGH, HIGH, LOW, LOW); // L1 Green, L2 Red
      }
      break;
  }
}

// Helper function to update all 6 LEDs at once
void setLights(bool r1, bool y1, bool g1, bool r2, bool y2, bool g2) {
  digitalWrite(L1_RED, r1);
  digitalWrite(L1_YELLOW, y1);
  digitalWrite(L1_GREEN, g1);
  
  digitalWrite(L2_RED, r2);
  digitalWrite(L2_YELLOW, y2);
  digitalWrite(L2_GREEN, g2);
}
